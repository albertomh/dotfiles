[user]
    name = {{ .name }}
    email = {{ .email }}

[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    line-numbers = true
    # Use n and N to move between diff sections.
    navigate = true

[init]
    defaultBranch = main

[branch]
    # Show most recently changed branches first.
    sort = -committerdate

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autostash = true

[merge]
    # required by delta pager
    conflictstyle = zdiff3

[status]
    # show all files rather than just the top-level directory
    showUntrackedFiles = all

[diff]
    algorithm = histogram

[alias]
    # up = !"git fetch origin --prune && git pull origin --tags main && git pull origin main"%
    up = !"git fetch origin --prune && git remote set-head origin --auto >/dev/null && git pull origin \"$(git rev-parse --abbrev-ref origin/HEAD | sed 's@^origin/@@')\""%
