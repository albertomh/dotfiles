[user]
    name = {{ .name }}
    email = {{ .email }}
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rebase]
    autostash = true
[merge]
    conflictstyle = zdiff3
[diff]
    algorithm = histogram
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
