# homebrew
# ------------------------------------------------------------------------------

eval "$(/opt/homebrew/bin/brew shellenv)"


# completions
# ------------------------------------------------------------------------------

autoload -Uz compinit && compinit


# history
# ------------------------------------------------------------------------------

HISTSIZE=100000
SAVEHIST=100000
setopt share_history hist_ignore_dups hist_ignore_space


# tools
# ------------------------------------------------------------------------------

eval "$(starship init zsh)"

export DOCKER_CLI_HINTS=false

export EZA_ICONS_AUTO=always
export EZA_COLORS="da=97"

# Docker socket for Colima (brew-installed dockerd alternative)
export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"


# zsh plugins
# ------------------------------------------------------------------------------

# <https://github.com/zsh-users/zsh-history-substring-search>
source $(brew --prefix)/share/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down


# aliases
# ------------------------------------------------------------------------------

alias cat="bat"

alias d="docker"
alias dps="docker ps"

alias g="git"
alias gd="git diff"
alias glog="git log --oneline"
alias gp='git pull origin $(git rev-parse --abbrev-ref HEAD)'
alias gs="git status"
alias wip='git commit -n -m "wip"'

alias ls="eza"
alias ll="eza -la --git"

alias tf="tofu"

# navigation aliases

alias dotfiles="cd ~/Projects/dotfiles"


# git helpers
# ------------------------------------------------------------------------------

_git_default_branch() {
  git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null |
    sed 's@^origin/@@' ||
    echo main
}

gcm() {
  git checkout "$(_git_default_branch)" "$@"
}

gf() {
  local branch
  branch="$(_git_default_branch)"
  git fetch origin "$branch" --prune &&
    git pull origin "$branch"
}

gc() { git checkout "$@"; }
_gc_local_branches() {
  local -a branches
  branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
  _describe 'local branch' branches
}
compdef _gc_local_branches gc

